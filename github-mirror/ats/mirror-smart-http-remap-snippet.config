# Put this before the generic Jenkins/ci.trafficserver.apache.org catch-all remap.
#
# Smart Git HTTP traffic is served by github-mirror-smart-http on the
# controller. Do not cache these responses in ATS.
#
# Don't pool origin sessions to the mirror. docker-proxy keeps ATS's side of an
# idle connection open after httpd closes it (KeepAliveTimeout 5), so a reused
# session swallows the request and stalls for the 180s no-activity timeout.
map https://ci.trafficserver.apache.org/mirror/ http://localhost:9417/mirror/ \
  @plugin=conf_remap.so @pparam=proxy.config.http.cache.http=0 \
    @pparam=proxy.config.http.server_session_sharing.match=none \
  @plugin=header_rewrite.so @pparam=hdr_rw_git.config
