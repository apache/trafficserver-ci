# header_rewrite rules for the /mirror/ remap
# (/opt/ats/etc/trafficserver/hdr_rw_git.config).
#
# Smart Git HTTP responses are per-request pack negotiations, so tell clients
# and any intermediate proxy not to store them. The remap also disables ATS
# caching with conf_remap.
cond %{READ_RESPONSE_HDR_HOOK}
     set-header Cache-Control "no-store, private"
