pipeline {
	agent {label 'freebsd'}
	stages {
		stage('Clone') {
			steps {
				echo 'Starting Clone'
				dir('ci') {
					checkout([$class: 'GitSCM',
						branches: [[name: 'main']],
						userRemoteConfigs: [[url: 'https://ci.trafficserver.apache.org/mirror/trafficserver-ci.git']],
						extensions: [[$class: 'CloneOption', shallow: true, depth: 10, noTags: true, timeout: 10]]
					])
				}
				dir('src') {
					script {
						String branch = env.SHA1
						if (! branch) {
							branch = '*/' + env.GITHUB_BRANCH
						}

						int attempt = 0
						retry(3) {
							if (attempt > 0) {
								// Spread retries out so jobs that failed together do not come back together.
								sleep(time: 30 * attempt + (int) (Math.random() * 60), unit: 'SECONDS')
							}
							attempt++
							timeout(time: 5, unit: 'MINUTES') {
								checkout([$class: 'GitSCM',
									branches: [[name: branch]],
									userRemoteConfigs: [[url: env.GITHUB_URL, refspec: "+refs/heads/${env.GITHUB_BRANCH}:refs/remotes/origin/${env.GITHUB_BRANCH}"]],
									// Branch builds normally checkout the current branch tip. If a manually
									// requested SHA is older than this shallow depth, checkout should fail fast
									// instead of falling back to a large full-history fetch.
									// Only this branch is fetched, so a requested SHA must also be on it.
									extensions: [[$class: 'CloneOption', honorRefspec: true, shallow: true, depth: 1000, noTags: true, timeout: 10]],
								])
							}
						}
					}
				}
				echo 'Finished Clone'
			}
		}
		stage('Build') {
			steps {
				echo 'Starting build'
				dir('src') {
					sh '''#!/bin/bash
						set -x
						set -e

						NPROC=3
						export PATH=/opt/bin:$PATH

						if [ -d cmake ]
						then
							echo "Building with CMake"

							presetpath="../ci/jenkins/branch/CMakePresets.json"
							[ -f "${presetpath}" ] && cp -f "${presetpath}" .

							cmake -B build --preset=branch-freebsd
							cmake --build build -j${NPROC} -v
						else
							echo "Building with autotools"

							autoreconf -fiv
							./configure --enable-experimental-plugins
							gmake -j${NPROC}
						fi
					'''
				}
			}
		}
	}
	
	post { 
		cleanup { 
			cleanWs()
		}
	}
}
