pipeline {
    agent {
        docker {
            image 'ats/fedora:44'
            //registryUrl 'https://ci.trafficserver.apache.org/'
            args '-v ${HOME}/ccache:/tmp/ccache:rw'
            label 'linux'
        }
    }
    environment {
        CCACHE_DIR = "/tmp/ccache"
        CCACHE_MAXSIZE = "20G"
        CCACHE_BASEDIR = "${WORKSPACE}"
        // Shared cache on docker11. ccache 4.7 and newer read this variable; see
        // ccache-remote/README.md.
        CCACHE_REMOTE_STORAGE = "http://72.167.32.163:9090|layout=bazel"
        // Records this build's cache statistics for the Build stage's post step.
        CCACHE_STATSLOG = "${WORKSPACE}/ccache-stats.log"
    }
    stages {
        stage('Clone') {
            steps {
                dir('src') {
                    echo "${sha1}"
                    script {
                        int attempt = 0
                        retry(3) {
                            if (attempt > 0) {
                                // Spread retries out so jobs that failed together do not come back together.
                                sleep(time: 30 * attempt + (int) (Math.random() * 60), unit: 'SECONDS')
                            }
                            attempt++
                            timeout(time: 5, unit: 'MINUTES') {
                                checkout([$class: 'GitSCM',
                                    branches: [[name: sha1]],
                                    extensions: [
                                        // Keep this depth high enough for PreBuildMerge to find the merge base
                                        // between the PR head and target branch. If it is too low, checkout will
                                        // fail during the local merge with shallow-history / missing-ancestor errors.
                                        [$class: 'CloneOption', honorRefspec: true, shallow: true, depth: 1000, noTags: true, timeout: 4],
                                        // We have to set an identity for the merge step because Git requires
                                        // the user.name and user.email to be set to do a merge.
                                        [$class: "UserIdentity",
                                            name: "ATS CI User",
                                            email: "noreply@trafficserver.apache.org"
                                        ],
                                        [$class: "PreBuildMerge",
                                            options: [
                                                mergeTarget: "${GITHUB_PR_TARGET_BRANCH}",
                                                fastForwardMode: "NO_FF",
                                                mergeRemote: "origin",
                                                mergeStrategy: "DEFAULT"
                                            ]
                                        ],
                                    ],
                                    userRemoteConfigs: [[url: github_url,
                                        refspec: "+refs/heads/${GITHUB_PR_TARGET_BRANCH}:refs/remotes/origin/${GITHUB_PR_TARGET_BRANCH} +refs/pull/${GITHUB_PR_NUMBER}/head:refs/remotes/origin/pr/${GITHUB_PR_NUMBER}/head +refs/pull/${GITHUB_PR_NUMBER}/merge:refs/remotes/origin/pr/${GITHUB_PR_NUMBER}/merge"]]])
                            }
                        }
                    }
                    sh '''#!/bin/bash
                            set -x

                            echo
                            echo
                            uname -a
                            cat /etc/*release*

                            echo
                            git show HEAD^2 --no-patch
                            git show HEAD^1 --no-patch
                            echo

                            git show -n 10 --decorate --graph --oneline --no-patch
                            echo
                            echo
                    '''
                }
                echo 'Finished Cloning'
            }
        }
        stage('HRW4U') {
            steps {
                dir('src') {
                    sh '''#!/bin/bash
                        set -x
                        set -e

                        if [ ! -f tools/hrw4u/Makefile ]
                        then
                            echo "hrw4u is not available on this branch."
                        else
                            # uv is installed under /opt/bin in this image.
                            export PATH=/opt/bin:$PATH

                            # uv cannot hardlink from its cache into the venv because
                            # Jenkins bind mounts the workspace into the container.
                            export UV_LINK_MODE=copy

                            cd tools/hrw4u

                            # Fedora's antlr4 package installs the generator as
                            # `antlr4`; the Makefile defaults to the Homebrew name.
                            make ANTLR=antlr4 test
                        fi
                    '''
                }
            }
        }
        stage('Build') {
            steps {
                echo 'Starting build'
                dir('src') {
                    sh '''#!/bin/bash
                        set -x
                        set -e
                        export PATH=/opt/bin:$PATH

                        if [ -d cmake ]
                        then
                            # We don't use c++20 features yet, but we want to make
                            # sure we can build with the flag set.
                            cmake -B build --preset ci-fedora-cxx20
                            cmake --build build -v
                            cmake --install build
                            pushd build
                            ctest -j4 --output-on-failure --no-compress-output -T Test
                            /tmp/ats/bin/traffic_server -K -R 3
                            popd
                        else
                            # Pre 10.x branches only support autotools.

                            # We don't use c++20 features yet, but we want to make
                            # sure we can build with the flag set.
                            export CXXSTD=20

                            autoreconf -fiv
                            ./configure --enable-experimental-plugins --enable-example-plugins --prefix=/tmp/ats/ --enable-werror --enable-debug --enable-wccp --enable-ccache
                            make -j4 V=1 Q=
                            make -j4 check VERBOSE=Y V=1
                            make install
                            /tmp/ats/bin/traffic_server -K -k -R 3
                        fi
                    '''
                }
            }
            post {
                always {
                    // Show whether this build hit the local and remote caches.
                    sh 'ccache --show-log-stats -v || true'
                }
            }
        }
    }
    post {
        cleanup {
            cleanWs()
        }
    }
}
