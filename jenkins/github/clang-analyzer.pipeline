pipeline {
    agent {
        docker {
            image 'ci.trafficserver.apache.org/ats/ubuntu:26.04'
            registryUrl 'https://ci.trafficserver.apache.org/'
            args '-v /home/rooter/clang-analyzer:/tmp/clang-analyzer:rw'
            label 'docker'
        }
    }
    stages {
        stage('Clone') {
            steps {
                dir('src') {
                    echo "${sha1}"
                    script {
                        int attempt = 0
                        retry(3) {
                            if (attempt > 0) {
                                // Spread retries out so jobs that failed together do not come back together.
                                sleep(time: 30 * attempt + (int) (Math.random() * 60), unit: 'SECONDS')
                            }
                            attempt++
                            timeout(time: 5, unit: 'MINUTES') {
                                checkout([$class: 'GitSCM',
                                    branches: [[name: sha1]],
                                    extensions: [
                                        // Keep this depth high enough for PreBuildMerge to find the merge base
                                        // between the PR head and target branch. If it is too low, checkout will
                                        // fail during the local merge with shallow-history / missing-ancestor errors.
                                        [$class: 'CloneOption', honorRefspec: true, shallow: true, depth: 1000, noTags: true, timeout: 4],
                                        // We have to set an identity for the merge step because Git requires
                                        // the user.name and user.email to be set to do a merge.
                                        [$class: "UserIdentity",
                                            name: "ATS CI User",
                                            email: "noreply@trafficserver.apache.org"
                                        ],
                                        [$class: "PreBuildMerge",
                                            options: [
                                                mergeTarget: "${GITHUB_PR_TARGET_BRANCH}",
                                                fastForwardMode: "NO_FF",
                                                mergeRemote: "origin",
                                                mergeStrategy: "DEFAULT"
                                            ]
                                        ],
                                    ],
                                    userRemoteConfigs: [[url: github_url,
                                        refspec: "+refs/heads/${GITHUB_PR_TARGET_BRANCH}:refs/remotes/origin/${GITHUB_PR_TARGET_BRANCH} +refs/pull/${GITHUB_PR_NUMBER}/head:refs/remotes/origin/pr/${GITHUB_PR_NUMBER}/head +refs/pull/${GITHUB_PR_NUMBER}/merge:refs/remotes/origin/pr/${GITHUB_PR_NUMBER}/merge"]]])
                            }
                        }
                    }
                    sh '''#!/bin/bash
                            set -x

                            echo
                            echo
                            uname -a
                            cat /etc/*release*

                            echo
                            git show HEAD^2 --no-patch
                            git show HEAD^1 --no-patch
                            echo

                            git show -n 10 --decorate --graph --oneline --no-patch
                            echo
                            echo
                    '''
                }
                echo 'Finished Cloning'
            }
        }
        stage('Build') {
            steps {
                echo 'Starting build'
                dir('src') {
                    sh '''#!/bin/bash
                        set -x
                        set -e

                        export PATH=/opt/bin:$PATH

                        if [ -d cmake ]
                        then
                            cmake -B build --preset ci-clang-analyzer -DCMAKE_CXX_SCAN_FOR_MODULES=OFF

                            # The full build is not needed: the compilation database is written at
                            # configure time, and the only sources generated at build time are the
                            # ParseRules tables that src/tscore/ParseRules.cc includes. Module
                            # scanning is disabled above because otherwise the compilation database
                            # refers to .modmap files that only a full build creates. Newer
                            # ci-clang-analyzer presets also set it; it is passed explicitly for the
                            # release branches whose presets do not. Branches without these
                            # generated tables get the full build.
                            parse_rules="src/tscore/ParseRulesCType src/tscore/ParseRulesCTypeToLower src/tscore/ParseRulesCTypeToUpper"
                            missing=0
                            for target in ${parse_rules}
                            do
                                if ! ninja -C build -t targets all | grep -q "^${target}:"
                                then
                                    missing=1
                                fi
                            done
                            if [ "${missing}" -eq 0 ]
                            then
                                cmake --build build -v --target ${parse_rules}
                            else
                                cmake --build build -v
                            fi

                            # Everything under lib/ is vendored third party code except libswoc,
                            # which the project maintains, so only analyze libswoc there.
                            lib_excludes=()
                            for lib_dir in lib/*/
                            do
                                lib_dir="${lib_dir%/}"
                                if [ "${lib_dir}" != "lib/swoc" ]
                                then
                                    lib_excludes+=(--exclude "${WORKSPACE}/src/${lib_dir}")
                                fi
                            done

                            analyze-build \
                                --cdb build/compile_commands.json \
                                -v \
                                --status-bugs \
                                --keep-empty \
                                "${lib_excludes[@]}" \
                                -enable-checker alpha.unix.cstring.BufferOverlap \
                                -enable-checker alpha.core.BoolAssignment \
                                -enable-checker alpha.core.CastSize \
                                -o ${WORKSPACE}/output/${GITHUB_PR_NUMBER} \
                                --html-title="clang-analyzer: ${GITHUB_PR_NUMBER}"
                        else
                            echo "CMake builds are not supported for the this branch."
                            echo "Falling back to autotools."
                            autoreconf -fiv
                            scan-build --keep-cc ./configure --enable-experimental-plugins --with-luajit
                            make -j4 -C lib all-local V=1 Q=
                            scan-build --keep-cc --exclude "${WORKSPACE}/src/lib/highway" \
                                -enable-checker alpha.unix.cstring.BufferOverlap -enable-checker \
                                alpha.core.BoolAssignment -enable-checker alpha.core.CastSize \
                                --status-bugs --keep-empty \
                                -o ${WORKSPACE}/output/${GITHUB_PR_NUMBER} --html-title="clang-analyzer: ${GITHUB_PR_NUMBER}" \
                                make -j3 V=1 Q=
                            make -j4
                        fi

                        # The above will have a non-zero exit if it finds problems. Thus,
                        # because of `set -e`, if we get here the report was clean.
                        touch "${WORKSPACE}/output/No Errors Reported"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'output/**/*', fingerprint: true, allowEmptyArchive: true
        }
        cleanup {
            cleanWs()
        }
    }
}
